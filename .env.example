# Copy this file to .env.local and fill in your own values.
# Everything here is Stripe test mode - no real card is ever charged.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses row level security, so it is only ever imported by
# the Stripe webhook handler, which runs without a logged in user.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe -----------------------------------------------------------------
# Test mode secret key, starts with sk_test_
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Price ID of the monthly Pro subscription, starts with price_
STRIPE_PRO_PRICE_ID=price_your_price_id

# Printed by `stripe listen` when you forward webhooks locally, starts with whsec_
# In production this comes from the webhook endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# --- App --------------------------------------------------------------------
# Used to build absolute Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
